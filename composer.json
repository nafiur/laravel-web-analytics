{
    "name": "nafiur/laravel-web-analytics",
    "description": "High-performance Web Traffic & Visitor Analytics Dashboard for Laravel with real-time SSE live streaming",
    "keywords": [
        "laravel",
        "analytics",
        "web-analytics",
        "visitor-tracking",
        "traffic-monitor",
        "real-time",
        "sse"
    ],
    "homepage": "https://github.com/nafiur/laravel-web-analytics",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nafiur Rahman",
            "email": "nafiurme@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Nafiur\\WebAnalytics\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nafiur\\WebAnalytics\\WebAnalyticsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}